+void WebGPUCanvas::releaseBlitSnapshot(){
+	blit_snapshot_valid=false;
+	if( blit_view ){
+		res->invalidateBindGroupsFor( blit_view );
+		wgpuTextureViewRelease( blit_view );
+		blit_view=0;
+	}
+	if( blit_texture ){
+		wgpuTextureRelease( blit_texture );
+		blit_texture=0;
+	}

{
  "name": "stranded-ii-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Extended content and world authoring, with a shared JSON CLI and Blitz viewport",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit && node --check electron/main.cjs && node --check electron/preload.cjs && node --check engine/studio.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "cli": "node electron/cli.cjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": { "node": ">=22.12.0" }
}

.lib "user32.dll"
qol_win_create%(exstyle%,class*,title*,style%,x%,y%,width%,height%,parent%,menu%,instance%,param%):"CreateWindowExW"
qol_win_destroy%(window%):"DestroyWindow"
qol_win_text%(window%,buffer*,length%):"GetWindowTextW"
qol_win_settext%(window%,buffer*):"SetWindowTextW"
qol_win_message%(window%,message%,wparam%,lparam%):"SendMessageW"
qol_win_focus%(window%):"SetFocus"
qol_win_getfocus%():"GetFocus"
qol_win_client%(window%,buffer*):"GetClientRect"
qol_win_invalidate%(window%,rect%,erase%):"InvalidateRect"
qol_win_update%(window%):"UpdateWindow"

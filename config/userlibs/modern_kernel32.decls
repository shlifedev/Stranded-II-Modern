.lib "kernel32.dll"
modern_file_move%(source$,destination$,flags%):"MoveFileExA"
modern_file_copy%(source$,destination$,failIfExists%):"CopyFileA"
modern_file_open%(name$,access%,share%,security%,creation%,attributes%,template%):"CreateFileA"
modern_file_flush_handle%(handle%):"FlushFileBuffers"
modern_handle_close%(handle%):"CloseHandle"
modern_file_find%(name$,data*):"FindFirstFileA"
modern_find_close%(handle%):"FindClose"
modern_last_error%():"GetLastError"
modern_sleep(milliseconds%):"Sleep"
modern_counter%(buffer*):"QueryPerformanceCounter"
modern_counter_frequency%(buffer*):"QueryPerformanceFrequency"
